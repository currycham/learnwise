# 复制为 .env 后填写。只有 DEEPSEEK_API_KEY 是必填的

# 模型：DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
# MODEL_PRO=deepseek-v4-pro
# MODEL_FLASH=deepseek-flash

# 联网检索：博查  https://open.bochaai.com 。不填只用模型自己的知识（仅供测试）
BOCHA_API_KEY=

# 网站地址（登录 cookie 是否加 Secure、邮件里的链接）
SITE_URL=http://127.0.0.1:8400

# 登录验证码邮件。不填时验证码打印在日志里（本机开发）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 内测邀请码：新用户注册要填，留空表示开放注册
INVITE_CODE=
# 管理员邮箱，逗号分隔：能看 /admin，不受每日次数限制
ADMIN_EMAILS=

# 页面底部公示的模型信息（面向公众上线前，按生成式 AI 登记结果填写）
MODEL_DISCLOSURE=内容由 DeepSeek 大模型生成

# 成本控制
DAILY_BUDGET_YUAN=30
USER_DAILY_DOMAINS=5
USER_DAILY_PAGES=20
USER_DAILY_AI=80
JOB_CONCURRENCY=2
